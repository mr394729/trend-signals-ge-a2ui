# Copy to .env and fill in. The Makefile loads .env and exports every value.
# Keep values bare (no quotes, no trailing comments) so make can read them.

# ---- Google Cloud project (Vertex AI for Gemini, Cloud Run for the agent) ------
GOOGLE_CLOUD_PROJECT=your-project-id
# Optional: looked up with gcloud when empty.
PROJECT_NUMBER=
REGION=us-central1

# ---- Gemini on Vertex AI ---------------------------------------------------------
# Gemini 3.x is served from the global endpoint only; regional values return 404.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL=gemini-3.7-flash

# ---- Gemini Enterprise -----------------------------------------------------------
# The app (engine) id from the Gemini Enterprise console. Required by make register.
GEMINI_ENTERPRISE_APP_ID=your-ge-app-id
DISCOVERY_ENGINE_LOCATION=global

# ---- Agent -----------------------------------------------------------------------
# Most model calls the agent may make in one turn (tool calls included).
MAX_HOPS_PER_TURN=10
